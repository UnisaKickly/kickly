@startuml
node "Smartphone" <<device>> as Smartphone {
  node "Android / iOS" <<executionEnvironment>> as MobileOS {
    component "Secure Storage\n(token di sessione)" as SecureStorage
  }
  node "Flutter Runtime (Dart)" <<executionEnvironment>> as Flutter {
    artifact "Kickly (APK / IPA)" <<artifact>> as KicklyArtifact
    component "Presentation Layer\n(boundary)" as GUI
    component "Domain Layer\n(control, entity)" as Domain
    component "Data Layer\n(Repository)" as Data
    component "supabase_flutter SDK" as SupabaseFlutter
    component "firebase_messaging SDK" as FirebaseMessaging

    GUI --> Domain
    Domain --> Data
    Data --> SupabaseFlutter
    Data --> FirebaseMessaging
  }
}

cloud "Supabase Cloud" <<executionEnvironment>> as SupabaseCloud {
  database "PostgreSQL\n(Row Level Security)" as Postgres
  component "API Gateway\n(REST / PostgREST)" as APIGateway
  component "Auth" as Auth
  component "Realtime" as Realtime
  node "Edge Functions (Deno)" <<executionEnvironment>> as EdgeFunctions {
    component "RSVP" as EdgeRSVP
    component "pagamenti / webhook Stripe" as EdgePagamenti
    component "cancellazione account" as EdgeCancellazione
    component "notifiche" as EdgeNotifiche
    component "email di allerta" as EdgeEmail
  }

  APIGateway --> Postgres
  EdgeFunctions --> Postgres
}

' Stripe gestisce i pagamenti in modalita' test tramite Stripe Connect.
cloud "Stripe Connect" as Stripe {
  component "API pagamenti" as StripeAPI
}

' FCM recapita le notifiche push al dispositivo.
cloud "Firebase Cloud Messaging" as FCM {
  component "Push notification" as FCMService
}

' Il servizio email consegna le comunicazioni e l'accesso via email.
cloud "Servizio email" as Email {
  component "Invio email" as EmailService
}

Smartphone --> SupabaseCloud : «protocol» HTTPS (REST / JSON)
Smartphone --> SupabaseCloud : «protocol» WSS (Realtime)
Smartphone --> Stripe : «protocol» HTTPS (Checkout)

EdgePagamenti --> StripeAPI : HTTPS
EdgeNotifiche --> FCMService : HTTPS
EdgeEmail --> EmailService : HTTPS (API email)
FCMService --> Smartphone : Push (TLS)
Auth --> EmailService : SMTP (TLS)

@enduml
